{
    "name": "anibrosdesign-crm",
    "description": "Anibros CRM \u2014 2026-grade multi-tenant real estate CRM and marketing operations platform",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node -e \"const fs = require('fs'); if (fs.existsSync('../public/index.html')) { fs.copyFileSync('../public/index.html', '../public/app.html'); fs.unlinkSync('../public/index.html'); }\"",
        "lint": "eslint .",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
        "server:dev": "tsx watch server/src/server.ts",
        "server:build": "tsc --noEmit -p tsconfig.server.json",
        "server:start": "tsx server/src/server.ts",
        "test": "vitest run",
        "test:native": "vitest run server/src/tests",
        "db:migrate": "tsx server/src/db/migrate.ts",
        "api:dev": "tsx watch server/src/api.ts",
        "worker:dev": "tsx watch server/src/worker.ts",
        "db:provision": "tsx server/src/db/provision-cli.ts",
        "api:export": "tsx scripts/export-openapi.ts",
        "api:types": "tsx scripts/export-openapi.ts && openapi-typescript docs/openapi.json -o src/api/schema.d.ts",
        "api:check": "tsx scripts/export-openapi.ts --check",
        "test:db:clean": "tsx scripts/clean-test-dbs.ts",
        "test:server": "vitest run server/src/tests",
        "test:web": "vitest run src",
        "db:report-integrity": "tsx scripts/report-data-integrity.ts",
        "db:restore-drill": "tsx scripts/backup-restore-drill.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.5.0",
        "@mui/x-charts": "9.15.0",
        "@tanstack/react-query": "^5.104.2",
        "argon2": "^0.45.1",
        "cookie": "^2.0.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.3.0",
        "libphonenumber-js": "^1.12.10",
        "nodemailer": "^10.1.1",
        "pg": "^8.23.1",
        "prom-client": "^15.1.3",
        "qrcode.react": "^4.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.90.0",
        "react-router-dom": "^7.18.4",
        "tsx": "^4.23.15",
        "ws": "^8.22.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@eslint/js": "^9.9.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/cookie": "^0.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@types/supertest": "^7.2.1",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.18",
        "eslint": "^9.9.1",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "globals": "^15.9.0",
        "jsdom": "^30.1.2",
        "openapi-typescript": "^7.13.0",
        "playwright": "^1.64.0",
        "postcss": "^8.4.35",
        "supertest": "^7.3.1",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.3.0",
        "vite": "^5.4.2",
        "vitest": "^2.1.9"
    }
}